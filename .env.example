# Configurações do Django
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True

# Banco de Dados
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
DEFAULT_FROM_EMAIL=noreply@lvksistemas.com.br

# Configurações da API Asaas
ASAAS_API_KEY=sua-api-key-do-asaas
ASAAS_ENVIRONMENT=sandbox
SITE_URL=http://localhost:8000

# Configuração Asaas
# Os dados bancários são configurados automaticamente no painel do Asaas
# Banco: 461 - Asaas I.P S.A (configuração automática)
# Beneficiário: Configurado no painel administrativo do Asaas